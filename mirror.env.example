# Copy this file to mirror.env and add the two source tokens below.
# A destination token is only needed when mirroring to another Slack workspace.
SLACK_SOURCE_USER_TOKEN='xoxp-source-user-token'
SLACK_SOURCE_APP_TOKEN='xapp-source-socket-mode-token'
# slack, local, or both
SLACK_MIRROR_TARGET='local'

# Docker Compose overrides this to /data/archive.
SLACK_ARCHIVE_DIR='./slack-archive'

# Only needed for slack or both.
SLACK_DEST_USER_TOKEN='xoxp-destination-user-token'

# Every public channel, private channel, one-to-one DM, and group DM that the
# source user belongs to.
SLACK_MIRROR_TYPES='public_channel,private_channel,im,mpim'

# Leave empty to keep generated names. Set to 'archive-' to add a prefix.
SLACK_CHANNEL_PREFIX=''

# Optional. Slack generally permits about one message per second per channel.
SLACK_POST_INTERVAL='1.05'

# Check once a minute for newly joined channels and DMs.
SLACK_RESCAN_INTERVAL='60'

# Docker Compose overrides this to /data/slack-mirror.sqlite3.
# SLACK_MIRROR_DB='/absolute/path/to/slack-mirror.sqlite3'
# SLACK_LOCAL_MIRROR_DB='/absolute/path/to/local-state.sqlite3'
